#include<iostream>
#include<stdlib.h>
#include<string.h>
using namespace std;

#define MAX 10

class shoppinglist
{
public:
    char b[20][30], p[30];
    int n, pos, i;

    void create();
    void insertion();
    void deletion();
    void display();
};

void shoppinglist::create()
{
    cout << "Enter no of items: ";
    cin >> n;

    for(i = 0; i < n; i++)
    {
        cout << "Enter the item " << i + 1 << ": ";
        cin >> b[i];
    }
}

void shoppinglist::insertion()
{
    cout << "Enter the position to insert: ";
    cin >> pos;

    if(pos > n)
    {
        cout << "Invalid location";
    }
    else
    {
        for(i = n - 1; i >= pos - 1; i--)
        {
            strcpy(b[i + 1], b[i]);
        }

        cout << "Enter the item to insert: ";
        cin >> p;

        strcpy(b[pos - 1], p);
        n++;
    }

    cout << "\nThe list after insertion:";
    display();
}

void shoppinglist::deletion()
{
    cout << "Enter the position you want to delete: ";
    cin >> pos;

    if(pos > n)
    {
        cout << "Invalid location";
    }
    else
    {
        for(i = pos; i < n; i++)
        {
            strcpy(b[i - 1], b[i]);
        }

        n--;
    }

    cout << "\nThe list after deletion:";
    display();
}


void shoppinglist::display()
{
    cout << "\nThe items in the shopping list are:\n";

    for(i = 0; i < n; i++)
    {
        cout << i + 1 << ". " << b[i] << endl;
    }
}

int main()
{
    shoppinglist l;
    int ch;

    do
    {
        cout << "\n1. Create";
        cout << "\n2. Add Item";
        cout << "\n3. Delete Item";
        cout << "\n4. Display";
        cout << "\n5. Exit";

        cout << "\nEnter your choice: ";
        cin >> ch;

        switch(ch)
        {
            case 1:
                l.create();
                break;

            case 2:
                l.insertion();
                break;

            case 3:
                l.deletion();
                break;

            case 4:
                l.display();
                break;

            case 5:
                exit(0);

            default:
                cout << "Invalid choice";
        }

    } while(ch != 5);

    return 0;
}
