#include <iostream>
using namespace std;

#define MAX 5

class Stack {
    string car[MAX];
    int top;

public:
    Stack() {
        top = -1;
    }

    void parkCar(string name) {
        if (top == MAX - 1) {
            cout << "Parking Garage is Full!\n";
        } else {
            car[++top] = name;
            cout << name << " entered the garage.\n";
        }
    }

    void leaveCar() {
        if (top == -1) {
            cout << "Parking Garage is Empty!\n";
        } else {
            cout << car[top] << " left the garage.\n";
            top--;
        }
    }

    void display() {
        if (top == -1) {
            cout << "No cars in garage.\n";
        } else {
            cout << "Cars in garage:\n";
            for (int i = top; i >= 0; i--) {
                cout << car[i] << endl;
            }
        }
    }
};

int main() {
    Stack s;
    int choice;
    string name;

    do {
        cout << "\n--- CAR PARKING GARAGE ---\n";
        cout << "1. Enter Car\n";
        cout << "2. Leave Car\n";
        cout << "3. Display Cars\n";
        cout << "4. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            cout << "Enter car name/number: ";
            cin >> name;
            s.parkCar(name);
            break;

        case 2:
            s.leaveCar();
            break;

        case 3:
            s.display();
            break;

        case 4:
            cout << "Exiting...\n";
            break;

        default:
            cout << "Invalid choice!\n";
        }
    } while (choice != 4);

    return 0;
}
